# Anthropic API anahtarı (Ollama kullanıyorsanız boş bırakabilirsiniz)
ANTHROPIC_API_KEY=

# Twilio kimlik bilgileri (https://console.twilio.com)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token

# Twilio WhatsApp gönderen numara (Sandbox: whatsapp:+14155238886)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Sizin WhatsApp numaranız (bildirimler buraya gelecek)
# Format: whatsapp:+90XXXXXXXXXX
OWNER_WHATSAPP=whatsapp:+90XXXXXXXXXX
